# engine 配置示例
#
# 用法：
#   ./build/engine.exe run --config engine.cfg --ids 760 --n 8
#   ./build/engine.exe --config engine.cfg --print-config
#   ./build/test_gen.exe --config engine.cfg --ids 1000,1001 --n 33
#
# 优先级：命令行 > 本文件 > 环境变量 > 内置默认值
# 完整键表见 docs/CONFIG.md 或 --help。

[engine]
# 模型路径：.gguf 文件或 safetensors 目录（自动识别容器，不依赖扩展名）
model = <MODEL_DIR>/YourModel-Q4_K_M.gguf

# 上下文长度（KV cache 大小）；不设置时生成入口按 prompt+n 自动估算
ctx = 512

# CPU 专家线程数，0 = 自动（physical cores - 1）
threads = 0

# 放在显存的 MoE 层数：auto/-1 = 按实测空闲显存自适应（层粒度）
gpu_layers = auto

# 装载完成后必须剩余的空闲显存（MiB）。不足时自动减少 GPU 层并打印决策依据。
vram_margin_mb = 1200

# auto-margin 决策器：装载后用实测空闲显存把 CPU 专家层抬升到 GPU（只花真正剩下的余量，
# 并保证仍留下 vram_margin_floor_mb）。显式 --vram-margin / --gpu-layers 时不生效。
# 35B 实测：自动 +1 层，free 1450 -> 952 MiB，decode -0.6 ms/token。
# vram_auto_layers = true
# vram_margin_floor_mb = 900
# vram_auto_layers_max = 2

# 放置估算时给 KV / 激活 / scratch 预留的显存（MiB）
workspace_mb = 768

# ---- 放置策略（见 FEATURE-MATRIX.md §1、docs/CONFIG.md §6.3）----
# auto（默认）= 装载前实测空闲显存/内存，三档决策：
#   gpu              权重 + KV + 激活全部放得下显存（最快）
#   vram+ram split   放不下显存但放得下 显存+内存（MoE 专家层粒度卸载）
#   ssd stream       连内存都放不下 —— 仅此时 SSD 才是候选，且默认关闭、本版本未实现
# 原则：“显存+内存放得下就没有必要 SSD”。SSD 必须显式开启（且当前必定报未实现）。
# placement_policy = auto   # auto | gpu | split | ssd  (CLI: --placement)
# 决策器要求装载后保留的主机内存（MiB），0 = 自动 max(1 GiB, 总内存/16)
# host_margin_mb = 0
# SSD 专家流式（默认关；PCIe×8/机械盘上通常净负收益；本版本只有接口占位）
# ssd_stream = false
# ssd_cache = <SSD_CACHE_DIR>
# 决策器判定装不下时仍强行加载（驱动会分页，预期单数字 tok/s）
# allow_oversubscribe = false

# 禁用 CUDA Graph（默认 false）
no_graph = false

# 打印放置 / 内核选择 / 显存决策依据（等价于 RUNNER_DEBUG=1）
debug = false

# ---- 启动交互（见 FEATURE-MATRIX.md §3、docs/CONFIG.md §8）----
# 终端里 serve/run 启动前询问 KV 精度 / 是否 CPU 专家卸载 / ctx；
# 非 TTY（管道/服务/CI）永远不询问，脚本行为不变。
# interactive = true
# 跳过全部询问，直接使用计算出的默认值（--yes / --no-interactive 同效）
# assume_yes = false
# 交互式选模型的候选目录（空 = <MODEL_DIR> 存在则用它，否则当前目录）
# model_dir = <MODEL_DIR>

# ---- KV cache 精度 / 长上下文（见 docs/CONFIG.md §3.3.1、§6.1、§6.2）----
# KV 精度：f32（默认/历史布局）| q8_0（34 B/32 值）| q4_0（18 B/32 值）。
# 9B 每 token KV：f32 64 KiB / q8_0 17 KiB / q4_0 9 KiB。量化 KV 走分块
# online-softmax attention（长上下文不再掉 50%）；MLA 模型强制 f32。
# kv_type = f32
# --ctx 0 = 按显存自适应推导最大 ctx；非 0 时也会被夹到能放下的上限并打印账目
# ctx_auto = true
# 激活行上限（prompt 分块 prefill）：长上下文必须分块，否则 logits 缓冲爆炸
# prefill_rows = 512
# decode attention 的 split-K 份数（prefill 固定用 1）
# kv_split = 32
# KV 放主机内存（当前版本未实现，仅解析并打印说明）
# kv_offload = false

# 模型语义覆盖（默认全部从 GGUF metadata 推导）
# router      = topk_softmax | sigmoid_topk
# norm_topk   = -1 | 0 | 1
# no_yarn     = false
# norm_plus1  = -1 | 0 | 1

# 内核选择阈值（可被 --kernel-calibrate 生成的缓存覆盖）
# row_threshold = 2048
# q6k_x4_min   = 32768
# q6k_split    = 0        # 0 = auto

# ---- Windows 进程/线程调度优先级（真实桌面机，见 docs/CONFIG.md §3.5.1）----
# 桌面后台程序（LANDrop/Steam/浏览器）会抢 CPU，宿主 GEMV 每层损失 0.1-0.3 ms。
# 1 = HIGH_PRIORITY_CLASS（默认，推荐），2 = ABOVE_NORMAL，0 = NORMAL（关闭/回退）
# 注意：永远不要用 REALTIME 类（会饿死输入/IO/驱动提交线程）。
# win_priority = 1
# CPU worker 线程相对优先级：-1 = auto（win_priority>0 时 HIGHEST），0/1/2 = 继承/ABOVE_NORMAL/HIGHEST
# win_thread_priority = -1
# 把 worker 绑到"先物理核后 SMT"顺序的逻辑 CPU（实测持平，默认关，仅 A/B）
# win_affinity = 0

[kernel]
# 由 `test_gen --model <m> --kernel-calibrate` 自动写入，格式：
#   <quant type> <n_out>x<n_in> = <plan>
# 例：
#   Q6_K 248320x4096 = q6k_dp4a
#   Q5_K 12288x4096  = q5k_dp4a_s
#   Q8_0 151936x896  = q8_0_bm

# ---- MTP / speculative decoding (models that ship a nextn / MTP head) ----
# mtp = false            # enable greedy MTP speculative decoding
# mtp_k = 2              # chained draft tokens per round (1..3)
# mtp_gpu = true         # keep the MTP block's routed experts in VRAM when they fit
# mtp_vram_margin_mb = 256
# mtp_ctx_prefill = true # fill the MTP layer's attention history for the prompt
